# Host-only Restic/R2 configuration.
# Copy to /etc/whatsapp-ip-agent/backup.env, set mode 0600, and never commit
# the populated file.
RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
RESTIC_PASSWORD_FILE=/etc/whatsapp-ip-agent/restic-password
AWS_ACCESS_KEY_ID=replace_with_r2_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Host and Compose paths.
PRODUCTION_ENV_FILE=/etc/whatsapp-ip-agent/production.env
COMPOSE_PROJECT_DIR=/opt/whatsapp-ip-agent
COMPOSE_FILE=docker-compose.prod.yml
COMPOSE_PROJECT_NAME=whatsapp-ip-agent-prod

# Optional names when the Compose project uses non-default volume names.
# BACKUP_APP_DATABASE=whatsapp_agent
# BACKUP_N8N_DATABASE=n8n
# BACKUP_EVOLUTION_DATABASE=evolution
# BACKUP_N8N_VOLUME=whatsapp-ip-agent-prod_n8n_data
# BACKUP_EVOLUTION_REDIS_VOLUME=whatsapp-ip-agent-prod_evolution_redis_data
# BACKUP_CADDY_DATA_VOLUME=whatsapp-ip-agent-prod_caddy_data
# BACKUP_CADDY_CONFIG_VOLUME=whatsapp-ip-agent-prod_caddy_config
