# ====================================================
# PostgreSQL & n8n Database Configuration
# ====================================================
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=whatsapp_agent

# ====================================================
# n8n Configuration
# ====================================================
N8N_ENCRYPTION_KEY=replace_with_secure_random_string
# N8N_WEBHOOK_URL_EXTERNAL=https://n8n.example.com/  # Optional: only if n8n needs external webhook callbacks (Phase 10)

# ====================================================
# Backend (Fastify) Configuration
# ====================================================
# Ensure this matches your production domain
CORS_ORIGIN=https://app.example.com

# URL-encoded password must be used here!
DATABASE_URL=postgresql://n8n:replace_with_url_encoded_secure_password@postgres:5432/whatsapp_agent?schema=public

# Admin Authentication
ADMIN_USERNAME=admin
# Generate hash using: npx bcryptjs "your_password"
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
# Generate secret using: openssl rand -hex 32
JWT_SECRET=replace_with_secure_random_string

# Webhook secret shared between backend and n8n
N8N_WEBHOOK_SECRET=replace_with_secure_random_string

# AI Provider Configuration (Optional)
AI_PROVIDER=gemini
# AI_API_KEY=your_provider_api_key
# AI_MODEL=openai/gpt-oss-20b
