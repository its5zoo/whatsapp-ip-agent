generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  IN_PROGRESS
  ON_HOLD
  CONVERTED
  NOT_INTERESTED
  CLOSED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ActivityType {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  FOLLOW_UP_CREATED
  FOLLOW_UP_RESCHEDULED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_CANCELLED
  NOTE_ADDED
  NOTE_EDITED
  NOTE_DELETED
}

model Conversation {
  id                String    @id @default(uuid())
  channel           String
  externalUserId    String    @map("external_user_id")
  currentQuestionId String?   @map("current_question_id")
  data              Json      @default("{}")
  isCompleted       Boolean   @default(false) @map("is_completed")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  lead              Lead?

  @@unique([channel, externalUserId])
  @@index([isCompleted])
  @@map("conversations")
}

model Lead {
  id              String    @id @default(uuid())
  conversationId  String    @unique @map("conversation_id")
  conversation    Conversation @relation(fields: [conversationId], references: [id])

  name            String
  organization    String
  email           String
  mobile          String
  city            String
  preferredComm   String    @map("preferred_comm")
  phoneCallTime   String?   @map("phone_call_time")

  flowType        String    @map("flow_type")
  answers         Json      @default("{}")
  status          LeadStatus @default(NEW)

  createdAt       DateTime  @default(now()) @map("created_at")

  followUps       FollowUp[]
  notes           InternalNote[]
  activities      Activity[]

  @@index([flowType])
  @@index([email])
  @@map("leads")
}

model FollowUp {
  id          String         @id @default(uuid())
  leadId      String         @map("lead_id")
  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledAt DateTime       @map("scheduled_at")
  note        String
  status      FollowUpStatus @default(PENDING)
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([status])
  @@index([scheduledAt])
  @@map("follow_ups")
}

model InternalNote {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([leadId])
  @@map("internal_notes")
}

model Activity {
  id          String       @id @default(uuid())
  leadId      String       @map("lead_id")
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        ActivityType
  description String
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@index([type])
  @@map("activities")
}

model ProcessedWhatsappMessage {
  messageId   String   @id @map("message_id")
  waId        String   @map("wa_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_whatsapp_messages")
}

model WhatsappOutboundMessage {
  id               String    @id @default(uuid())
  inboundMessageId String    @unique @map("inbound_message_id")
  waId             String    @map("wa_id")
  text             String
  status           String
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now()) @map("next_attempt_at")
  sendingAt        DateTime? @map("sending_at")
  sentAt           DateTime? @map("sent_at")
  lastError        String?   @map("last_error")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@map("whatsapp_outbound_messages")
}
